# PitSense Backend Environment Configuration
# ============================================================

# Google Gemini API key for natural language race engineer synthesis.
# If omitted or left empty, PitSense will operate cleanly in local rule-based fallback mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model selection (defaults to gemini-3.6-flash if omitted)
GEMINI_MODEL=gemini-3.6-flash
